set -euf -o pipefail

CBPASTE_BIN=cbpaste
if ! type -P "$CBPASTE_BIN" &>/dev/null; then
  SCRIPT_DIR="$(dirname "${BASH_SOURCE[0]}")"
  CBPASTE_BIN="$SCRIPT_DIR/cbpaste"
fi

export CBPASTE_STRIP_NEWLINE=1

# Fetch the clipboard content exactly once and load it into a tmux buffer.
"$CBPASTE_BIN" | tmux load-buffer -

# Count the lines directly from the tmux buffer.
line_count=$(tmux show-buffer | wc -l)

if [[ "$line_count" -le 1 ]]; then
  # Paste directly from the buffer.
  tmux paste-buffer
else
  if tmux list-commands | grep -q '^display-popup ' &>/dev/null; then
    # Preview and paste using the buffer instead of re-evaluating the binary.
    tmux display-popup -T "Clipboard" "tmux show-buffer" ';' \
      'confirm-before' '-p' 'Paste? [y/n]' 'paste-buffer' || true
  else
    # Fallback: Extract only the first line for the prompt to avoid shell
    # escaping issues with large multi-line payloads in the tmux command line.
    preview=$(tmux show-buffer | head -n 1)
    tmux confirm-before -p "'${preview}...' PASTE? [y/n]" \
      "paste-buffer" || true
  fi
fi
