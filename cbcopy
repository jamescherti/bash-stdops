set -euf -o pipefail

SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
TMP_FILE=""
TMP_FILE2=""

USE_DISK=0
OPT_SANITIZE=0
OPT_VERIFY=0

# shellcheck disable=SC2329
cleanup() {
  if [[ -n "${TMP_FILE:-}" && -f "$TMP_FILE" ]]; then
    rm -f "$TMP_FILE"
  fi

  if [[ -n "${TMP_FILE2:-}" && -f "$TMP_FILE2" ]]; then
    rm -f "$TMP_FILE2"
  fi
}

# shellcheck disable=SC2329
error_handler() {
  local errno="$?"
  echo "$SCRIPT_NAME: Unexpected error at ${BASH_SOURCE[1]}:${BASH_LINENO[0]}" \
    "('${BASH_COMMAND}' exited with status $errno)." >&2
  exit "${errno}"
}

trap "error_handler" ERR
trap "cleanup" EXIT INT TERM
set -o errtrace

sanitize_utf8() {
  if type -P iconv &>/dev/null; then
    # -c: Discard characters that cannot be converted instead of terminating
    # when encountering such characters. POSIX requires that this option does
    # not change the exit status of the program.
    iconv -c -f UTF-8 -t UTF-8
  else
    cat
  fi
}

cbcopy_pbcopy() {
  if [[ "$USE_DISK" == 1 ]]; then
    pbcopy <"$TMP_FILE"
  else
    pbcopy
  fi
}

cbcopy_wlcopy() {
  local opts
  opts=("--type" "text/plain;charset=utf-8")
  if [[ "$USE_DISK" == 1 ]]; then
    wl-copy "${opts[@]}" <"$TMP_FILE"
  else
    wl-copy "${opts[@]}"
  fi
}

cbcopy_xclip() {
  if [[ "$USE_DISK" == 1 ]]; then
    xclip -i -selection clipboard <"$TMP_FILE"
  else
    xclip -i -selection clipboard
  fi
}

main() {
  while getopts "sc" opt; do
    case "$opt" in
    s)
      OPT_SANITIZE=1
      USE_DISK=1
      ;;
    c)
      OPT_VERIFY=1
      USE_DISK=1
      ;;
    *)
      echo "Usage: $SCRIPT_NAME [-s] [-c]" >&2
      echo "  -s  Sanitize UTF-8 (activates disk buffering)." >&2
      echo "  -c  Verify clipboard contents (activates disk buffering)." >&2
      exit 1
      ;;
    esac
  done
  shift $((OPTIND - 1))

  # Source bash-stdops library
  local script_dir
  script_dir="$(dirname "${BASH_SOURCE[0]}")"
  local stdops_lib="$script_dir/.bash-stdops.inc.sh"
  if [[ ! -f "$stdops_lib" ]]; then
    echo "$SCRIPT_NAME: Error: Required helper library not found" \
      "at '$stdops_lib'." >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$stdops_lib"

  if [[ "$USE_DISK" == 1 ]]; then
    if ! TMP_FILE="$(mktemp)"; then
      echo "$SCRIPT_NAME: Error: Failed to create a temporary file." >&2
      exit 1
    fi

    if [[ "$OPT_SANITIZE" == 1 ]]; then
      sanitize_utf8 >"$TMP_FILE"
    else
      cat >"$TMP_FILE"
    fi
  fi

  # Copy
  if type -P pbcopy &>/dev/null; then
    if ! cbcopy_pbcopy; then
      echo "$SCRIPT_NAME: Error: Failed to copy data to the macOS" \
        "clipboard via 'pbcopy'." >&2
      exit 1
    fi
  elif is_wayland && type -P wl-copy &>/dev/null; then
    if ! cbcopy_wlcopy; then
      echo "$SCRIPT_NAME: Error: Failed to copy data to the Wayland" \
        "clipboard via 'wl-copy'." >&2
      exit 1
    fi
  elif type -P xclip &>/dev/null; then
    if ! cbcopy_xclip; then
      echo "$SCRIPT_NAME: Error: Failed to copy data to the X11 clipboard" \
        "via 'xclip'." >&2
      exit 1
    fi
  else
    if is_wayland; then
      echo "$SCRIPT_NAME: Error: No clipboard utility found for Wayland." \
        "Please install 'wl-clipboard' (provides 'wl-copy')." >&2
      exit 1
    else
      echo "$SCRIPT_NAME: Error: No supported clipboard utility found." \
        "Please install 'xclip' (Linux/X11), 'wl-clipboard' (Linux/Wayland)," \
        "or ensure 'pbcopy' is available (macOS)." >&2
      exit 1
    fi
  fi

  # Verify the clipboard is non-empty if the input file was non-empty.
  if [[ "$OPT_VERIFY" == 1 ]]; then
    export CBPASTE_STRIP_NEWLINE=0

    if [[ -s "$TMP_FILE" ]]; then
      local cbpaste_bin="$script_dir/cbpaste"
      if [[ ! -x "$cbpaste_bin" ]]; then
        echo "$SCRIPT_NAME: Error: Cannot verify clipboard contents:" \
          "Companion script '$script_dir/cbpaste' is missing or" \
          "not executable." >&2
        exit 1
      fi

      if ! TMP_FILE2="$(mktemp)"; then
        echo "$SCRIPT_NAME: Error: Failed to create a temporary file." >&2
        exit 1
      fi
      "$cbpaste_bin" >"$TMP_FILE2"
      if ! cmp "$TMP_FILE" "$TMP_FILE2" &>/dev/null; then
        echo "$SCRIPT_NAME: Error: Clipboard verification failed: Data was" \
          "sent to the clipboard, but reading it returned a" \
          "different content." >&2
        exit 1
      fi
    fi
  fi

  return 0
}

main "$@"
