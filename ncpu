# getconf _NPROCESSORS_ONLN: Works on almost all POSIX-compliant systems (Linux,
# macOS, Solaris) and is usually the most reliable first choice.
#
# nproc: Covers GNU/Linux environments where getconf might be missing or
# stripped down.
#
# sysctl -n hw.ncpu: Catches macOS and BSD variants if the standard POSIX
# utilities are unavailable.
#
# echo 1: Safe integer fallback to prevent syntax errors in downstream commands.

_NCPU=""

if ! _NCPU=$(getconf _NPROCESSORS_ONLN 2>/dev/null); then
  if ! _NCPU=$(nproc 2>/dev/null); then
    if ! _NCPU=$(sysctl -n hw.ncpu 2>/dev/null); then
      _NCPU=1
    fi
  fi
fi

echo "$_NCPU"
