IGNORE_COUNT=0

while [ "$#" -gt 0 ]; do
  case "$1" in
  -h | --help)
    echo "Usage: $0 [-h|--help] [--ignore <number>]"
    echo
    echo "Options:"
    echo "  -h, --help         Show this help message and exit."
    echo "  --ignore <number>  Subtracts the specified number of cores from the total."
    echo "                     If the resulting calculation is less than 1, it defaults to 1."
    exit 0
    ;;
  --ignore)
    if [ -n "$2" ]; then
      IGNORE_COUNT="$2"
      shift 2
    else
      echo "Error: --ignore requires a number." >&2
      exit 1
    fi
    ;;
  *)
    echo "Usage: $0 [-h|--help] [--ignore <number>]" >&2
    exit 1
    ;;
  esac
done

if [ "$_NCPU_CACHE" = "" ]; then
  # getconf _NPROCESSORS_ONLN: Works on almost all POSIX-compliant systems
  # (Linux, macOS, Solaris) and is usually the most reliable first choice.
  if ! _NCPU=$(getconf _NPROCESSORS_ONLN 2>/dev/null); then
    # nproc: Covers GNU/Linux environments where getconf might be missing or
    # stripped down.
    if ! _NCPU=$(nproc 2>/dev/null); then
      # sysctl -n hw.ncpu: Catches macOS and BSD variants if the standard POSIX
      # utilities are unavailable.
      if ! _NCPU=$(sysctl -n hw.ncpu 2>/dev/null); then
        # Safe integer fallback to prevent syntax errors in downstream commands.
        _NCPU=1
      fi
    fi
  fi
fi

if [ "$IGNORE_COUNT" -gt 0 ] 2>/dev/null; then
  _NCPU=$((_NCPU - IGNORE_COUNT))
fi

if [ "$_NCPU" -lt 1 ]; then
  _NCPU=1
fi

echo "$_NCPU"
