set -euo pipefail
set -o errtrace

declare -a CHROOT_MOUNTS
declare CHROOT_DIR=""

usage() {
  printf 'Usage: %s <chroot_directory>\n' "${0##*/}" >&2
  exit 1
}

cleanup() {
  local target
  local i

  # Unmount in reverse order of mounting
  for ((i = ${#CHROOT_MOUNTS[@]} - 1; i >= 0; i--)); do
    target="${CHROOT_MOUNTS[i]}"
    if mountpoint -q "$target"; then
      umount -R "$target" \
        || printf 'Warning: failed to unmount %s\n' "$target" >&2
    fi
  done
}

require_root() {
  if [[ "$(id -u)" -ne 0 ]]; then
    printf 'Error: root privileges required\n' >&2
    exit 1
  fi
}

validate_chroot() {
  if [[ ! -d "$CHROOT_DIR" ]]; then
    printf 'Error: directory does not exist: %s\n' "$CHROOT_DIR" >&2
    exit 1
  fi

  if [[ ! -x "$CHROOT_DIR/bin/bash" ]]; then
    printf 'Error: missing executable: %s/bin/bash\n' "$CHROOT_DIR" >&2
    exit 1
  fi
}

mount_fs() {
  mkdir -p "${CHROOT_MOUNTS[@]}"

  if ! mountpoint -q "$CHROOT_DIR/dev"; then
    mount --rbind /dev "$CHROOT_DIR/dev"
    mount --make-rslave "$CHROOT_DIR/dev"
  fi

  if ! mountpoint -q "$CHROOT_DIR/proc"; then
    mount -t proc proc "$CHROOT_DIR/proc"
  fi

  if ! mountpoint -q "$CHROOT_DIR/sys"; then
    mount --rbind /sys "$CHROOT_DIR/sys"
    mount --make-rslave "$CHROOT_DIR/sys"
  fi

  if ! mountpoint -q "$CHROOT_DIR/run"; then
    mount --bind /run "$CHROOT_DIR/run"
  fi
}

# shellcheck disable=SC2317
error_handler() {
  local errno="$?"
  echo -- "Error: ${BASH_SOURCE[1]}:${BASH_LINENO[0]}" \
    "(${BASH_COMMAND} exited with status $errno)" >&2
  exit "${errno}"
}

main() {
  trap "error_handler" ERR
  require_root

  if [[ "$#" -ne 1 ]]; then
    usage
  fi

  CHROOT_DIR="$(realpath "$1")"

  CHROOT_MOUNTS=(
    "$CHROOT_DIR/dev"
    "$CHROOT_DIR/proc"
    "$CHROOT_DIR/sys"
    "$CHROOT_DIR/run"
  )

  validate_chroot

  trap cleanup EXIT INT TERM

  printf 'Preparing chroot: %s\n' "$CHROOT_DIR"

  mount_fs

  chroot "$CHROOT_DIR" /bin/bash -l
}

main "$@"
