#!/usr/bin/env bash
#
# Author: James Cherti
# URL: https://github.com/jamescherti/bash-stdops
#
# Description:
# ------------
# Search upward through the directory hierarchy starting from the current
# physical directory until a matching entry is found or root (/) is reached.
# Prints the absolute path of the first match found.
#
# Usage:
# ------
# findup [OPTION] [--] RELATIVE_PATH
#
# Options:
# -a, --any         Match any entry (default).
# -f, --file        Match regular files.
# -d, --directory   Match directories.
# -h, --help        Display help and exit.
#
# Examples:
# ---------
# 1. Find the root of a Git repository from a deep subdirectory:
#    git_dir="$(findup -d .git)"
#    project_root="${git_dir%/*}"
#
# 2. Locate the nearest project configuration file (e.g., pyproject.toml):
#    if config_file="$(findup pyproject.toml)"; then
#      printf 'Using config: %s\n' "$config_file"
#    fi
#
# Exit Status:
# ------------
# 0  Found matching entry or displayed help.
# 1  No matching entry found before reaching root.
# 2  Invalid arguments or path errors.
#
