set -euf -o pipefail

# export BORG_PASSPHRASE=''  # Allow the user to define this variable
export BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes

# Variables that can be modified
# _BORG_ENCRYPTION=none
BORGMACHINE_REPO=""
BORGMACHINE_PROFILE=""
BORGMACHINE_SCRIPT_PRE_HOOK=""
BORGMACHINE_INCLUDE=("$HOME")
BORGMACHINE_CREATE_ARGS=()
BORGMACHINE_PRUNE_ARGS=(
  --keep-daily 7
  --keep-weekly 4
  --keep-monthly 6
  --keep-yearly 1
  --keep-hourly 12
  --keep-minutely 60
)
BORGMACHINE_ARCHIVE_NAME="backup"
BORGMACHINE_LOG_DIR="$HOME/.logs"
BORGMACHINE_REPORTS_PATH="$HOME/.borgmachine/reports"
BORGMACHINE_REPORT_BACKED_UP_FILES_PATH=""

# Private variables
_BORG_LOG_FILE=""
_BORGMACHINE_CREATE_ARGS=(--verbose
  --filter AME
  --list
  --stats
  --show-rc
  --exclude-caches
)

_BORGMACHINE_BORG_EXE="$(type -P borg || true)"
if [[ -z "$_BORGMACHINE_BORG_EXE" ]]; then
  echo "Error: 'borg' executable not found." >&2
  exit 1
fi

# check if stdout is a terminal...
GREEN=""
NOCOLOR=""
_NCOLORS=""
if test -t 1; then
  # see if it supports colors...
  # Prevent set -e from aborting the script when TERM is unset or unsupported by
  # tput.
  _NCOLORS=$(tput colors 2>/dev/null || true)

  if [[ -n "$_NCOLORS" ]] && [[ "$_NCOLORS" -ge 8 ]]; then
    GREEN="\033[1;32m"
    NOCOLOR="\033[0m"
  fi
fi

_borg_log() {
  # local line
  # line="$(date +%Y-%m-%d-%T): $*"
  echo "$*"
  # echo "$line" >>"$_BORG_LOG_FILE"
}

_borg_nolog() {
  # Keep stderr separate from stdout so JSON/list parsers do not consume
  # warnings, and propagate exit codes.
  chrt -i 0 ionice -c3 nice -n 19 "$_BORGMACHINE_BORG_EXE" "$@"
}

_borg_run() {
  # local RED="\033[1;31m"
  echo -e "${GREEN}"
  _borg_log "[CMD] $*"
  echo -e "${NOCOLOR}"
  # Propagate the borg exit status instead of returning 0 unconditionally when
  # called with || or if !.
  chrt -i 0 ionice -c3 nice -n 19 "$_BORGMACHINE_BORG_EXE" "$@" 2>&1 #\
  # | tee -a "$_BORG_LOG_FILE" || return 1
}

_borg_init() {
  if ! [[ -d "$BORGMACHINE_LOG_DIR" ]]; then
    mkdir -p "$BORGMACHINE_LOG_DIR"
  fi

  _BORG_LOG_FILE="$BORGMACHINE_LOG_DIR/borg-backup.log"

  if ! [[ -f "$_BORG_LOG_FILE" ]]; then
    touch "$_BORG_LOG_FILE"
    chmod 640 "$_BORG_LOG_FILE"
  fi

  #if ! grep -q segments_per_dir "$BORGMACHINE_REPO/config" >/dev/null 2>&1; then
  #    _borg_log "Error: you need to init the backup path '$BORGMACHINE_REPO' with:" >&2
  #    _borg_log "borg init --encryption=$_BORG_ENCRYPTION $BORGMACHINE_REPO" >&2
  #    return 1
  #fi

  _borg_log "[BACKUP PATH] $BORGMACHINE_REPO"
  return 0
}

#
# BORG RESTORE
#
_borg_archive_exists() {
  local borg_list_archives
  readarray -t borg_list_archives < <(_borg_nolog list --format "{archive}{NEWLINE}")
  if [[ ${#borg_list_archives[@]} -eq 0 ]]; then
    return 1
  fi

  local archive
  local needle="$1"
  for archive in "${borg_list_archives[@]}"; do
    if [[ $archive = "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

BORG_SELECTED_ARCHIVE=''
BORG_MOST_RECENT_ARCHIVE=''
_borg_select_archives() {
  BORG_MOST_RECENT_ARCHIVE=''

  _borg_nolog list
  BORG_MOST_RECENT_ARCHIVE=$(_borg_nolog list --last 1 \
    --format "{archive}{NEWLINE}")

  if [[ "$BORG_MOST_RECENT_ARCHIVE" = "" ]]; then
    echo "Error: there are no archives in the backup." >&2
    exit 1
  fi

  echo

  while true; do
    read -r -p "Archive [default: $BORG_MOST_RECENT_ARCHIVE]: " \
      BORG_SELECTED_ARCHIVE
    if [[ "$BORG_SELECTED_ARCHIVE" = "" ]]; then
      BORG_SELECTED_ARCHIVE="$BORG_MOST_RECENT_ARCHIVE"
    fi

    if ! _borg_archive_exists "$BORG_SELECTED_ARCHIVE"; then
      echo "Error: The archive $BORG_SELECTED_ARCHIVE does not exist." >&2
      sleep 1
      continue
    fi

    break
  done
}

BORG_RESTORE_ATEXIT=0
BORG_RESTORE_TMP_DIR=""
borg_restore_atexit() {
  # Use an explicit signal exit status when provided so interrupted restores do
  # not exit 0.
  local errno="${1:-$?}"
  if [[ "$BORG_RESTORE_ATEXIT" -eq 0 ]]; then
    if [[ $BORG_RESTORE_TMP_DIR != "" ]] \
      && [[ -e "$BORG_RESTORE_TMP_DIR" ]]; then
      echo "[INFO] Delete tmp dir: $BORG_RESTORE_TMP_DIR"
      rm -fr "$BORG_RESTORE_TMP_DIR"
      BORG_RESTORE_TMP_DIR=""
    fi
    BORG_RESTORE_ATEXIT=1
  fi
  exit "$errno"
}

_borg_restore() {
  # Pass a non-zero status when terminated by a signal so the process does not
  # exit 0 on interruption.
  trap 'borg_restore_atexit' EXIT
  trap 'borg_restore_atexit 130' INT TERM HUP QUIT

  if [[ $# -eq 0 ]]; then
    echo "Error: you have to specify the file or the directory" \
      "in the first argument" >&2
    exit 1
  fi

  local borg_filename="$1"
  local borg_real_filename
  borg_real_filename=$(readlink -e --canonicalize-missing "$borg_filename")
  if [[ -e "$borg_real_filename" ]]; then
    echo "Error: $borg_real_filename exists already." >&2
    exit 1
  else
    echo "Path: $borg_real_filename"
    echo
  fi

  local borg_real_dirname
  borg_real_dirname=$(dirname "$borg_real_filename")

  #
  # Remove leading slash
  #
  local borg_path
  borg_path=$(echo "$borg_real_filename" | sed -e 's/^\///')

  # Choose the package:
  _borg_select_archives

  cd "$borg_real_dirname"

  #
  # Tmp directory
  #
  local relative_tmp_dir
  relative_tmp_dir=$(mktemp --tmpdir=. --directory)
  BORG_RESTORE_TMP_DIR=$(readlink -e --canonicalize-missing \
    "$relative_tmp_dir")
  cd "$BORG_RESTORE_TMP_DIR"
  if [[ $(find . -print | wc -l) -gt 1 ]]; then
    echo "Error: The temporary directory is not empty." >&2
    exit 1
  fi

  #
  # Extract file/dir
  #
  # Check that the extracted path exists before moving it, and leave the temp
  # directory before deleting it.
  _borg_run extract "::$BORG_SELECTED_ARCHIVE" "$borg_path" || true
  if [[ -e "$borg_path" ]]; then
    mv "$borg_path" "$borg_real_filename"
  fi
  cd "$borg_real_dirname"

  #
  # Delete the temporary directory
  #
  rm -fr "$BORG_RESTORE_TMP_DIR"
  BORG_RESTORE_TMP_DIR=''

  #
  # Print result
  #
  if [[ -e "$borg_real_filename" ]]; then
    echo "Restore successful: $borg_real_filename"
    return 0
  else
    echo "Restore FAILED: $borg_real_filename"
    return 1
  fi
}

_prune_and_compact() {
  # Prune and compact
  local errno=0
  local prune_exit=0
  _borg_run prune \
    --show-rc \
    --glob-archives "${BORGMACHINE_ARCHIVE_NAME}-*" \
    ${BORGMACHINE_PRUNE_ARGS[@]+"${BORGMACHINE_PRUNE_ARGS[@]}"} || prune_exit="$?"

  if [[ ${prune_exit} -gt 1 ]]; then
    echo "ERROR: Borg prune finished with an error." >&2
    errno=1
  fi

  # COMPAT: Free the disk space
  if type -P apt-get &>/dev/null; then
    # Debian stable version of borg does not support compact
    if ! _borg_run compact; then
      echo "WARNING: Borg compact finished with an error."
    fi
  else
    if ! _borg_run compact; then
      echo "ERROR: Borg compact finished with an error." >&2
      errno=1
    fi
  fi

  return "$errno"
}

_borg_backup() {
  local borg_archive_name_suffix=""
  if [[ $# -gt 0 ]]; then
    borg_archive_name_suffix="-$1"
    echo "[ARCHIVE NAME] suffix added: $borg_archive_name_suffix"
  fi

  local item
  for item in ${BORGMACHINE_INCLUDE[@]+"${BORGMACHINE_INCLUDE[@]}"}; do
    if ! [[ $item =~ ^/ ]]; then
      echo "Error: '$item' has to be an absolute path." >&2
      exit 1
    fi

    if ! [[ -e "$item" ]]; then
      echo "Error: '$item' does not exist." >&2
      exit 1
    fi
  done

  # Read last log
  # local previous_borg_archive_name
  # previous_borg_archive_name=$(_borg_nolog list --last 1 --format '{archive}{NEWLINE}')

  # Defer prune and compact until after the backup succeeds so failed backups do
  # not remove existing recovery points.
  local errno=0

  # Backup
  local backup_exit=0
  local borg_archive_name
  borg_archive_name="::$BORGMACHINE_ARCHIVE_NAME-$(date +%Y%m%d-%H%M%S)$borg_archive_name_suffix"
  _borg_run create \
    "${_BORGMACHINE_CREATE_ARGS[@]}" \
    ${BORGMACHINE_CREATE_ARGS[@]+"${BORGMACHINE_CREATE_ARGS[@]}"} \
    "$borg_archive_name" \
    ${BORGMACHINE_INCLUDE[@]+"${BORGMACHINE_INCLUDE[@]}"} || backup_exit="$?"

  # Catch all non-zero borg create exit codes, including fatal errors (>= 2).
  if [[ ${backup_exit} -ne 0 ]]; then
    echo "ERROR: Borg backup finished with an error. Borg prune canceled." >&2
    exit 1
  fi

  # Check if the size is too big
  _borg_nolog info "$borg_archive_name"

  # local deduplicated_size
  # deduplicated_size=$(_borg_nolog info "$borg_archive_name" --json | jq '.archives[0].stats.deduplicated_size')
  #
  # deduplicated_size=$((deduplicated_size / 1000)) # kb
  #
  # if [[ $deduplicated_size -gt 600000 ]]; then
  #   echo >&2
  #   echo "You can delete the archive with:" >&2
  #   echo "BORG_REPO=$BORGMACHINE_REPO borg delete '$borg_archive_name'" >&2
  #   echo "" >&2
  #   echo "[WARNING] the archive '$borg_archive_name' is too big: $deduplicated_size Kb" >&2
  #   echo
  # fi

  # Save the list
  mkdir -p "$BORGMACHINE_REPORTS_PATH"
  _borg_nolog list --format '{path}{NL}' \
    "$borg_archive_name" | sed -e 's/^\(.\+\)$/\/\1/g' \
    >"$BORGMACHINE_REPORT_BACKED_UP_FILES_PATH"

  # Prune and compact
  # local errno=0
  # _prune_and_compact || errno="$?"
  # Run prune and compact only after the new archive and file report have been created.
  _prune_and_compact || errno="$?"

  # Does not work with remote
  # local borg_repo_size
  # borg_repo_size=$(du -hs "$BORGMACHINE_REPO")
  # echo "Borg repo size: $borg_repo_size"

  exit "$errno"
}

_borg_archive_size() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "Error: 'jq' command is required to parse archive size." >&2
    return 1
  fi

  local list_archives
  readarray -t list_archives < <(_borg_nolog list --format '{archive}{NL}') \
    || return 1
  local archive
  for archive in "${list_archives[@]}"; do
    local deduplicated_size
    deduplicated_size=$(_borg_nolog info "::$archive" --json \
      | jq '.archives[0].stats.deduplicated_size')
    # Convert bytes to megabytes (MB) to match the printed Mb unit.
    deduplicated_size=$((deduplicated_size / 1000000)) # mb
    echo "$archive: ${deduplicated_size} Mb"
  done
}

main() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: $0 <profile> <command> [args...]" >&2
    echo "" >&2
    echo "Commands:" >&2
    echo "--------"
    echo "backup" >&2
    echo "restore" >&2
    echo "ls" >&2
    echo "borg" >&2
    echo "size" >&2
    echo
    echo "Profiles:"
    echo "---------"
    if [[ -d "$HOME/.borgmachine/profiles/" ]]; then
      ls -1 "$HOME/.borgmachine/profiles/"
    else
      echo "(No profiles directory found)"
    fi
    exit 1
  fi

  BORGMACHINE_PROFILE="$1"
  shift

  if [[ ! -f "$HOME/.borgmachine/profiles/$BORGMACHINE_PROFILE" ]]; then
    echo "Error: Profile '$BORGMACHINE_PROFILE' not found." >&2
    exit 1
  fi

  # shellcheck disable=SC1090
  source "$HOME/.borgmachine/profiles/$BORGMACHINE_PROFILE"

  BORGMACHINE_REPORT_BACKED_UP_FILES_PATH="$BORGMACHINE_REPORTS_PATH/${BORGMACHINE_PROFILE}.backed_up_files"

  if [[ -z "${BORGMACHINE_REPO:-}" ]]; then
    echo "Error: BORGMACHINE_REPO is not defined in the " \
      "profile '$BORGMACHINE_PROFILE'." >&2
    exit 1
  fi

  if [[ $# -eq 0 ]]; then
    echo "BORG INCLUDES:     ${BORGMACHINE_INCLUDE[*]:-}"
    echo "BORG REPO:         ${BORGMACHINE_REPO}"
    echo "BORG PRUNE ARGS:   ${BORGMACHINE_PRUNE_ARGS[*]:-}"
    echo "BORG PRE HOOK:     ${BORGMACHINE_SCRIPT_PRE_HOOK}"
    echo "BORG ARCHIVE NAME: ${BORGMACHINE_ARCHIVE_NAME}"
    # echo "BORG LOG FILE:     ${_BORG_LOG_FILE}"
    echo "BORG ARGS:         ${BORGMACHINE_CREATE_ARGS[*]:-}"
    exit
  fi

  local cmd
  cmd="$1"
  shift

  export BORGMACHINE_REPO
  export BORG_REPO="$BORGMACHINE_REPO"

  if [[ $BORGMACHINE_SCRIPT_PRE_HOOK != "" ]]; then
    "$BORGMACHINE_SCRIPT_PRE_HOOK" "$@" || exit 1
  fi

  _borg_init || exit 1
  case "$cmd" in
  size)
    _borg_archive_size "$@"
    ;;
  backup)
    _borg_backup "$@"
    ;;
  restore)
    _borg_restore "$@"
    ;;
  ls)
    _borg_select_archives
    local borg_path
    borg_path=$(pwd | sed -e 's/^\///')
    # Remove the invalid {extra} format key and scope listing to borg_path when non-empty.
    if [[ -n "$borg_path" ]]; then
      _borg_nolog list "::$BORG_SELECTED_ARCHIVE" --format '{path}{NL}' "$borg_path"
    else
      _borg_nolog list "::$BORG_SELECTED_ARCHIVE" --format '{path}{NL}'
    fi
    ;;
  borg)
    "$_BORGMACHINE_BORG_EXE" "$@"
    ;;
  *)
    echo "Error: the command '$cmd' is invalid." >&2
    exit 1
    ;;
  esac
}

main "$@"
