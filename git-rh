#!/usr/bin/env bash
#
# Requirements:
#   - git
#
# Author: James Cherti
# URL: https://github.com/jamescherti/bash-stdops
#
# Description:
# ------------
# A safe wrapper around 'git reset --hard HEAD' that prevents accidental data
# loss. It previews all tracked modifications (staged and unstaged) scheduled to
# be discarded and requires explicit confirmation before resetting the tree.
# Untracked files are left untouched, and no prompt is shown if the working tree
# has no tracked changes.
#
# Usage:
#   git-rh
#
