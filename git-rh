set -euf -o pipefail

# Reject unexpected positional arguments or flags so passing a file path does
# not silently trigger a full working-tree reset.
if [[ $# -gt 0 ]]; then
  echo "Usage: ${0##*/}" >&2
  exit 1
fi

# Verify we are inside a Git work tree
if [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" != "true" ]]; then
  echo "Error: Not inside a Git working tree." >&2
  exit 1
fi

# Capture repository status (staged, unstaged, and untracked files)
status_output="$(git status --porcelain)"

# If the working tree is completely clean, no confirmation is needed
if [[ -z "${status_output}" ]]; then
  echo "Working tree is already clean. Nothing to reset."
  exit 0
fi

if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "Error: Repository does not have any commits yet (HEAD is unborn)." >&2
  exit 1
fi

# Check specifically for tracked modifications (staged or unstaged)
# git diff-index --quiet HEAD -- returns 1 if there are differences, 0 if clean
if git diff-index --quiet HEAD -- 2>/dev/null; then
  echo "No tracked changes to reset (only untracked files are present)."
  exit 0
fi

echo "The following tracked changes will be permanently discarded:"
echo "------------------------------------------------------------"
git status --short --untracked-files=no
echo "------------------------------------------------------------"

# Prompt for confirmation directly from the terminal
# Open /dev/tty directly because '[[ -r /dev/tty ]]' only checks inode mode
# bits (0666) and succeeds even when no controlling terminal is attached.
if ! { true </dev/tty; } 2>/dev/null; then
  echo "Error: Interactive terminal (/dev/tty) is not available." >&2
  exit 1
fi

response=""
if ! read -r -p "Are you sure you want to run 'git reset --hard HEAD'? [y/N] " \
  response </dev/tty; then
  echo
  echo "Reset aborted."
  exit 1
fi

case "${response}" in
[yY][eE][sS] | [yY])
  git reset --hard HEAD
  ;;
*)
  echo "Reset aborted."
  exit 1

  ;;
esac
