set -euo pipefail

main() (
  if [[ $# -lt 3 ]]; then
    printf 'Usage: run-every <seconds> <reference_file> <command...>\n' >&2
    return 1
  fi

  local interval="$1"
  local reference_file="$2"
  shift 2
  local command=("$@")
  local LC_ALL=C

  if [[ ! "$interval" =~ ^0*[1-9][0-9]*$ ]]; then
    printf 'Error: <seconds> must be a positive integer.\n' >&2
    return 1
  fi

  interval=${interval#"${interval%%[!0]*}"}

  if [[ -z "$reference_file" ]]; then
    printf 'Error: <reference_file> must not be empty.\n' >&2
    return 1
  fi
  case "$reference_file" in
  /*) ;;
  *) reference_file="./$reference_file" ;;
  esac

  if ! command -v flock >/dev/null 2>&1; then
    printf 'Error: flock is required.\n' >&2
    return 1
  fi

  local reference_dir=${reference_file%/*}
  mkdir -p "${reference_dir:-/}"
  exec 9>>"${reference_file}.lock"

  local status
  if flock -n -E 75 9; then
    :
  else
    status=$?
    if [[ $status -eq 75 ]]; then
      printf '[IGNORED] %s\n' "${command[*]}"
      return 0
    fi
    return "$status"
  fi

  if [[ -e "$reference_file" || -L "$reference_file" ]]; then
    if [[ ! -f "$reference_file" ]]; then
      printf 'Error: reference path is not a regular file: %s\n' "$reference_file" >&2
      return 1
    fi

    local last_run
    if stat --version >/dev/null 2>&1; then
      last_run=$(stat -L -c %Y "$reference_file")
    else
      last_run=$(stat -L -f %m "$reference_file")
    fi

    local current_time
    current_time=$(date +%s)
    if ((current_time < last_run || current_time - last_run < interval)); then
      printf '[IGNORED] %s\n' "${command[*]}"
      return 0
    fi
  fi

  touch "$reference_file"
  "${command[@]}" 9>&-
)

main "$@"
