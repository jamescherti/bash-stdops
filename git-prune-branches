#!/usr/bin/env bash
#
# Requirements:
#   - git (Version 2.43 or later for git show-ref --exists)
#
# Author: James Cherti
# URL: https://github.com/jamescherti/bash-stdops
#
# Description:
# ------------
# Remove local Git branches that have no same-named branch on origin.
#
# By default, the script lists the branches it would delete. Pass --delete to
# force-delete them locally, including unmerged and never-pushed branches.
# Branches checked out in any worktree are skipped.
