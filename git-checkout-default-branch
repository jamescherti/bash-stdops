set -Eeuo pipefail

# shellcheck disable=SC2317
error_handler() {
  local errno="$?"
  echo "Error: ${BASH_SOURCE[1]}:${BASH_LINENO[0]}" \
    "(${BASH_COMMAND} exited with status $errno)" >&2
  exit "${errno}"
}

require_git_repository() {
  git rev-parse --git-dir &>/dev/null \
    || {
      echo "Error: Not a git repository." >&2
      exit 1
    }
}

require_command() {
  type -P "$1" &>/dev/null \
    || {
      echo "Error: Required command '$1' not found in PATH." >&2
      exit 1
    }
}

get_current_branch() {
  git symbolic-ref --quiet --short HEAD 2>/dev/null
}

main() {
  trap error_handler ERR
  require_git_repository
  require_command git-is-clean
  require_command git-default-branch

  local default_branch
  if ! default_branch="$(git-default-branch)"; then
    # git-default-branch will print its own error messages to stderr
    exit 1
  fi

  if [ -z "$default_branch" ]; then
    echo "Error: git-default-branch returned an empty string." >&2
    exit 1
  fi

  git-is-clean || exit 1

  local current_branch
  current_branch="$(get_current_branch || echo HEAD)"

  if [ "$current_branch" = "$default_branch" ]; then
    echo "Already on default branch: ${default_branch}"
    return 0
  fi

  echo "git checkout ${default_branch}"
  git checkout --quiet "$default_branch"
}

main "$@"
