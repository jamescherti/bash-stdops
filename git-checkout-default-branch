#!/usr/bin/env bash
#
# Requirements:
#   - git
#   - git-default-branch
#   - git-is-clean
#
# Author: James Cherti
# URL: https://github.com/jamescherti/bash-stdops
#
# Description:
# ------------
# The git-checkout-default-branch script automatically checks out the default
# branch of the current Git repository, regardless of its name. It works in
# repositories where the default branch may be main, master, or any custom
# branch.
#
# This ensures the local repository is aligned with the remote default branch
# without requiring manual specification of the branch name.
