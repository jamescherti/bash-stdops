set -euo pipefail

TARGET_DIR=$(realpath "${1:-.}")

if ! OUTPUT=$(git -C "$TARGET_DIR" status --porcelain); then
  printf 'Error: %s: Could not check Git status.\n' "$TARGET_DIR" >&2
  exit 1
fi

if [[ -n "$OUTPUT" ]]; then
  printf 'Error: %s: Uncommitted modifications, deletions, or ' \
    "$TARGET_DIR" >&2
  printf 'untracked files detected.\n' >&2
  exit 1
fi
